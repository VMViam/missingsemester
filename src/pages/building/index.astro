---
import Base from "../../layouts/Base.astro";
import { projects } from "../../data/projects";

const languages = new Set(projects.map((project) => project.language)).size;
const latestYear = Math.max(...projects.map((project) => Number(project.year)));
---

<Base
  title="The Terminal — The Missing Semester"
  description="Projects built in the one-room schoolhouse, with links to each repository."
>
  <main class="workshop">
    <nav class="workshop__rail" aria-label="Breadcrumb">
      <a href="/">&larr; Back to school</a>
      <span>Period 03 &middot; Building</span>
    </nav>

    <header class="workshop__head">
      <h1>The Terminal</h1>
      <p class="workshop__lede">
        Things I have built, broken, and put back together. Each project is a
        question I shipped; the link goes to the repository.
      </p>

      <dl class="counts">
        <div><dt>Repositories</dt><dd>{projects.length}</dd></div>
        <div><dt>Languages</dt><dd>{languages}</dd></div>
        <div><dt>Latest push</dt><dd>{latestYear}</dd></div>
      </dl>
    </header>

    <section class="terminal" aria-labelledby="projects-title">
      <div class="terminal__bar">
        <span class="terminal__dots" aria-hidden="true">
          <i></i><i></i><i></i>
        </span>
        <p class="terminal__path">~/projects</p>
        <p class="terminal__count">{projects.length} public repos</p>
      </div>

      <div class="terminal__body">
        <p class="terminal__prompt"><span aria-hidden="true">$</span> ls -la</p>
        <h2 id="projects-title" class="visually-hidden">Projects</h2>

        <ol class="project-list">
          {
            projects.map((project, index) => (
              <li class="project">
                <a
                  href={`https://github.com/VMViam/${project.repo}`}
                  title={`Open ${project.label} on GitHub`}
                >
                  <span class="project__n" aria-hidden="true">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <span class="project__main">
                    <span class="project__name">{project.label}</span>
                    <span class="project__desc">{project.description}</span>
                  </span>
                  <span class="project__meta">
                    <span>{project.language}</span>
                    <span>{project.year}</span>
                  </span>
                  <span class="project__arrow" aria-hidden="true">
                    &nearr;
                  </span>
                </a>
              </li>
            ))
          }
        </ol>
      </div>
    </section>
  </main>
</Base>

<style>
  .workshop {
    max-width: var(--room-max);
    margin: 0 auto;
    padding: var(--space-xl) var(--space-m) var(--space-2xl);
  }

  .workshop__rail {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-s);
    margin-bottom: var(--space-l);
    padding-bottom: var(--space-s);
    border-bottom: 1px solid var(--paper-400);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-300);
  }

  .workshop__rail a {
    color: var(--ink-700);
    text-decoration: none;
  }

  .workshop__rail a:hover {
    color: var(--oak-700);
  }

  h1 {
    font-size: var(--step-4);
    letter-spacing: -0.03em;
  }

  .workshop__lede {
    max-width: 52ch;
    color: var(--fg-muted);
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .counts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-l);
    margin: var(--space-l) 0 0;
    padding: var(--space-s) 0;
    border-top: 1px solid var(--paper-400);
    border-bottom: 1px solid var(--paper-400);
  }

  .counts div {
    display: flex;
    flex-direction: column-reverse;
  }

  .counts dt {
    font-family: var(--font-sign);
    font-size: var(--step--1);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  .counts dd {
    margin: 0;
    font-size: var(--step-2);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .terminal {
    margin-top: var(--space-xl);
    background: var(--slate-900);
    border: 1px solid var(--slate-700);
    box-shadow: 0 28px 55px -40px color-mix(in srgb, var(--ink-900) 75%, transparent);
    color: var(--chalk-100);
    font-family: var(--font-mono);
  }

  .terminal__bar {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    padding: var(--space-2xs) var(--space-s);
    background: var(--slate-800);
    border-bottom: 1px solid var(--slate-700);
    font-size: 0.58rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--chalk-300);
  }

  .terminal__bar p {
    margin: 0;
  }

  .terminal__dots {
    display: flex;
    gap: 0.3rem;
  }

  .terminal__dots i {
    display: block;
    width: 0.45rem;
    height: 0.45rem;
    background: var(--gym-red-500);
    border-radius: 50%;
  }

  .terminal__dots i:nth-child(2) {
    background: var(--gym-yellow-500);
  }

  .terminal__dots i:nth-child(3) {
    background: var(--gym-green-500);
  }

  .terminal__count {
    margin-left: auto;
  }

  .terminal__body {
    padding: var(--space-m);
  }

  .terminal__prompt {
    margin: 0 0 var(--space-s);
    font-size: 0.75rem;
    color: var(--phosphor);
  }

  .terminal__prompt span {
    color: var(--phosphor-dim);
  }

  .project-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .project {
    border-top: 1px solid color-mix(in srgb, var(--chalk-100) 10%, transparent);
  }

  .project:first-child {
    border-top: 0;
  }

  .project a {
    display: grid;
    grid-template-columns: 2.2rem minmax(0, 1fr) auto 1.2rem;
    align-items: start;
    gap: var(--space-s);
    padding: var(--space-s) 0;
    color: inherit;
    text-decoration: none;
  }

  .project a:hover {
    background: color-mix(in srgb, var(--phosphor) 6%, transparent);
  }

  .project__n {
    padding-top: 0.18rem;
    font-size: 0.6rem;
    color: var(--phosphor-dim);
  }

  .project__main {
    display: grid;
    gap: 0.18rem;
    min-width: 0;
  }

  .project__name {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--chalk-100);
  }

  .project__desc {
    max-width: 58ch;
    font-family: var(--font-print);
    font-size: 0.8rem;
    line-height: 1.55;
    color: var(--chalk-300);
  }

  .project__meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.15rem;
    font-size: 0.56rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-300);
  }

  .project__arrow {
    font-size: 1rem;
    color: var(--phosphor);
  }

  .project a:hover .project__name,
  .project a:hover .project__arrow {
    color: var(--phosphor);
  }

  @media (max-width: 700px) {
    .workshop {
      padding: var(--space-l) var(--space-s) var(--space-xl);
    }

    .counts {
      gap: var(--space-m);
    }

    .terminal__body {
      padding: var(--space-s);
    }

    .project a {
      grid-template-columns: 1.6rem minmax(0, 1fr) 1rem;
      gap: var(--space-2xs) var(--space-s);
    }

    .project__meta {
      grid-column: 2;
      flex-direction: row;
      align-items: baseline;
      gap: var(--space-xs);
    }

    .project__arrow {
      grid-column: 3;
      grid-row: 1;
    }
  }
</style>
