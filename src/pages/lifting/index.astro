---
import Base from "../../layouts/Base.astro";
---

<Base
  title="Lifting — The Missing Semester"
  description="Period 04 of the one-room schoolhouse: the body is a subject too."
>
  <div class="chalk">
    <div class="chalk__frame">
      <header class="chalk__rail">
        <a href="/">&larr; The room</a>
        <p>Period 04 &middot; Lifting</p>
        <p class="chalk__object">The plate tree</p>
      </header>

      <main class="chalk__main">
        <p class="chalk__kicker">Subject 04 &middot; The chalkboard</p>

        <h1>Still being<br />written.</h1>

        <p class="chalk__lede">
          I haven&rsquo;t decided what belongs on this chalkboard yet &mdash; the
          program, the numbers, or the days I didn&rsquo;t want to show up at all.
        </p>

        <ol class="chalk__rules">
          <li><span aria-hidden="true">i.</span>Show up.</li>
          <li><span aria-hidden="true">ii.</span>Add a little weight.</li>
          <li><span aria-hidden="true">iii.</span>Repeat.</li>
        </ol>

        <p class="chalk__note">&mdash; the only three rules that ever stuck</p>
      </main>

      <footer class="chalk__foot">
        <a href="/reading/">Meanwhile, the library is open &rarr;</a>
        <p>The Missing Semester &middot; missingsemester.in</p>
      </footer>
    </div>
  </div>
</Base>

<style>
  .chalk {
    min-height: 100vh;
    padding: var(--space-s);
    background: var(--bg-page);
  }

  .chalk__frame {
    display: flex;
    flex-direction: column;
    min-height: calc(100vh - 2 * var(--space-s));
    padding: 0 clamp(1.25rem, 5vw, 4rem);
    background:
      radial-gradient(ellipse at 20% 8%, color-mix(in srgb, var(--chalk-100) 6%, transparent), transparent 55%),
      radial-gradient(ellipse at 85% 95%, color-mix(in srgb, var(--chalk-100) 4%, transparent), transparent 50%),
      var(--slate-900);
    border: 10px solid var(--oak-700);
    box-shadow:
      inset 0 0 0 1px color-mix(in srgb, var(--brass-500) 35%, transparent),
      0 30px 60px -40px color-mix(in srgb, var(--ink-900) 70%, transparent);
    color: var(--chalk-100);
  }

  .chalk__rail {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-s);
    padding: var(--space-s) 0;
    border-bottom: 1px solid color-mix(in srgb, var(--chalk-100) 16%, transparent);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--chalk-300);
  }

  .chalk__rail p {
    margin: 0;
  }

  .chalk__rail a {
    color: var(--chalk-100);
    text-decoration: none;
  }

  .chalk__rail a:hover {
    color: var(--brass-300);
  }

  .chalk__main {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    max-width: 48rem;
    padding: clamp(3.5rem, 9vw, 7rem) 0;
  }

  .chalk__kicker {
    margin: 0 0 var(--space-m);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--chalk-300);
  }

  h1 {
    margin: 0 0 var(--space-m);
    font-family: var(--font-hand);
    font-size: clamp(3.4rem, 9vw, 6.5rem);
    font-weight: 600;
    line-height: 0.92;
    letter-spacing: -0.015em;
    color: var(--chalk-100);
    text-shadow: 0 0 22px color-mix(in srgb, var(--chalk-100) 12%, transparent);
  }

  .chalk__lede {
    max-width: 44ch;
    margin: 0 0 var(--space-l);
    font-size: var(--step-1);
    line-height: 1.55;
    color: var(--chalk-300);
  }

  .chalk__rules {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s) clamp(1.5rem, 5vw, 4rem);
    margin: 0 0 var(--space-l);
    padding: var(--space-m) 0 0;
    border-top: 1px dashed color-mix(in srgb, var(--chalk-100) 20%, transparent);
    list-style: none;
  }

  .chalk__rules li {
    font-family: var(--font-hand);
    font-size: clamp(1.4rem, 2.6vw, 2rem);
    line-height: 1;
    color: var(--chalk-100);
  }

  .chalk__rules span {
    margin-right: var(--space-2xs);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: var(--brass-300);
    vertical-align: 0.55em;
  }

  .chalk__note {
    margin: 0;
    font-family: var(--font-hand);
    font-size: 1.25rem;
    color: var(--chalk-300);
    transform: rotate(-0.8deg);
    transform-origin: left center;
  }

  .chalk__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2xs) var(--space-m);
    padding: var(--space-s) 0 var(--space-m);
    border-top: 1px solid color-mix(in srgb, var(--chalk-100) 16%, transparent);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--chalk-300);
  }

  .chalk__foot p {
    margin: 0;
  }

  .chalk__foot a {
    color: var(--chalk-100);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--chalk-100) 35%, transparent);
  }

  .chalk__foot a:hover {
    color: var(--brass-300);
    border-bottom-color: var(--brass-300);
  }

  @media (max-width: 620px) {
    .chalk {
      padding: var(--space-3xs);
    }

    .chalk__frame {
      min-height: calc(100vh - 2 * var(--space-3xs));
      padding: 0 var(--space-s);
      border-width: 6px;
    }

    .chalk__object {
      display: none;
    }

    .chalk__rail,
    .chalk__foot {
      justify-content: space-between;
    }
  }
</style>
