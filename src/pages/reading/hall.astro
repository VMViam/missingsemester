---
import Base from "../../layouts/Base.astro";
---

<Base
  title="The Reading Hall — The Library"
  description="A reading hall at golden hour."
  bodyClass="hall-page"
>
  <main class="hall">
    <canvas id="hall-canvas" aria-label="A three-walled library at golden hour. Use the list below to browse the books."></canvas>

    <header class="hud">
      <a class="hud__back" href="/reading/">← The Library</a>
      <p class="hud__title">The Reading Hall</p>
      <p class="hud__note">prototype · one room</p>
    </header>

    <button class="hud__lamp" id="lamp" type="button" aria-pressed="true">☼ lamp on</button>
    <button class="hud__sound" type="button" disabled title="Sound comes later">♪ sound off</button>

    <aside class="panel" id="panel" hidden aria-live="polite">
      <button class="panel__close" id="panel-close" type="button" aria-label="Close">×</button>
      <div class="panel__cover" id="panel-cover"></div>
      <p class="panel__state" id="panel-state"></p>
      <h2 class="panel__title" id="panel-title"></h2>
      <p class="panel__author" id="panel-author"></p>
      <p class="panel__meta" id="panel-meta"></p>
      <p class="panel__notes" id="panel-notes"></p>
      <a class="panel__link" id="panel-link" href="#">Open the book →</a>
    </aside>

    <div class="tip" id="tip" hidden>
      <span class="tip__title" id="tip-title"></span>
      <span class="tip__author" id="tip-author"></span>
    </div>

    <p class="hint">Drag to look around · scroll to zoom · click a spine · L lamp · <span id="count">—</span> books</p>
    <div class="loading" id="loading"><span>Opening the hall…</span></div>
  </main>
</Base>

<script>
  import { createHall } from "../../lib/hall/scene";
  import type { Book } from "../../lib/books";
  import books from "../../data/books.json";

  const canvas = document.getElementById("hall-canvas") as HTMLCanvasElement;
  const panel = document.getElementById("panel") as HTMLElement;
  const loading = document.getElementById("loading") as HTMLElement;
  const count = document.getElementById("count") as HTMLElement;
  const tip = document.getElementById("tip") as HTMLElement;
  const lampBtn = document.getElementById("lamp") as HTMLButtonElement;
  const tipTitle = document.getElementById("tip-title") as HTMLElement;
  const tipAuthor = document.getElementById("tip-author") as HTMLElement;
  const cover = document.getElementById("panel-cover") as HTMLElement;
  const title = document.getElementById("panel-title") as HTMLElement;
  const author = document.getElementById("panel-author") as HTMLElement;
  const meta = document.getElementById("panel-meta") as HTMLElement;
  const notes = document.getElementById("panel-notes") as HTMLElement;
  const state = document.getElementById("panel-state") as HTMLElement;
  const link = document.getElementById("panel-link") as HTMLAnchorElement;

  count.textContent = String((books as Book[]).length);

  const hall = createHall(canvas, {
    onFocus(book: Book) {
      title.textContent = book.title;
      author.textContent = book.author;
      state.textContent =
        book.status === "reading" ? "on loan" : book.status === "read" ? "on the shelf" : "on hold";
      meta.textContent = [book.year, book.publisher, book.pages ? `${book.pages} pp` : null]
        .filter(Boolean)
        .join(" · ");
      notes.textContent = book.notes ?? "";
      notes.hidden = !book.notes;
      link.href = `/reading/${book.id}/`;

      cover.innerHTML = "";
      cover.style.background = book.spineColor ?? "#2f4858";
      if (book.coverUrl) {
        const img = document.createElement("img");
        img.src = book.coverUrl;
        img.alt = "";
        cover.append(img);
      } else {
        cover.textContent = book.title;
      }
      panel.hidden = false;
      requestAnimationFrame(() => panel.classList.add("is-open"));
    },
    onClose() {
      panel.classList.remove("is-open");
      window.setTimeout(() => (panel.hidden = true), 260);
    },
    onHover(book: Book | null, x: number, y: number) {
      if (!book) {
        tip.hidden = true;
        return;
      }
      tipTitle.textContent = book.title;
      tipAuthor.textContent = book.author;
      tip.style.transform = `translate(${x + 14}px, ${y + 16}px)`;
      tip.hidden = false;
    },
  });

  function toggleLamp() {
    const on = hall.toggleLamp();
    lampBtn.textContent = on ? "☼ lamp on" : "◌ lamp off";
    lampBtn.setAttribute("aria-pressed", String(on));
  }

  lampBtn.addEventListener("click", toggleLamp);
  window.addEventListener("keydown", (e) => {
    if (e.key.toLowerCase() === "l" && !e.metaKey && !e.ctrlKey) toggleLamp();
  });

  document.getElementById("panel-close")?.addEventListener("click", () => {
    (document as any).querySelector("#hall-canvas")?.click();
  });

  requestAnimationFrame(() => loading.classList.add("is-gone"));
  window.addEventListener("pagehide", () => hall.dispose());
</script>

<style is:global>
  body.hall-page {
    background: #150d09;
    overflow: hidden;
  }

  /* The hall is immersive: no site chrome. */
  body.hall-page .site-nav,
  body.hall-page .foot {
    display: none;
  }

  .hall {
    position: fixed;
    inset: 0;
    background: #150d09;
    overflow: hidden;
    color: var(--chalk-100);
  }

  #hall-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .hud {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    align-items: baseline;
    gap: var(--space-m);
    padding: var(--space-m);
    pointer-events: none;
    font-family: var(--font-sign);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: var(--step--1);
  }

  .hud a {
    pointer-events: auto;
    color: var(--chalk-200);
    text-decoration: none;
  }

  .hud a:hover {
    color: var(--chalk-100);
  }

  .hud__title {
    margin: 0;
    color: var(--brass-300);
  }

  .hud__note {
    margin: 0;
    color: var(--chalk-300);
    opacity: 0.55;
  }

  .hud__lamp {
    position: absolute;
    right: var(--space-m);
    bottom: calc(var(--space-m) + 2.5rem);
    padding: 0.45rem 0.8rem;
    border: 1px solid rgba(201, 162, 39, 0.35);
    border-radius: 999px;
    background: rgba(21, 13, 9, 0.6);
    color: var(--brass-300);
    font: inherit;
    font-family: var(--font-sign);
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s;
  }

  .hud__lamp:hover {
    border-color: var(--brass-400);
    color: var(--chalk-100);
  }

  .hud__sound {
    position: absolute;
    right: var(--space-m);
    bottom: var(--space-m);
    padding: 0.45rem 0.8rem;
    border: 1px solid rgba(247, 245, 239, 0.18);
    border-radius: 999px;
    background: rgba(21, 13, 9, 0.55);
    color: var(--chalk-300);
    font: inherit;
    font-family: var(--font-sign);
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    opacity: 0.6;
    cursor: not-allowed;
  }

  .tip {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 20;
    display: grid;
    gap: 1px;
    max-width: 19rem;
    padding: 0.4rem 0.55rem;
    background: rgba(20, 13, 9, 0.94);
    border: 1px solid rgba(201, 162, 39, 0.28);
    border-radius: 2px;
    pointer-events: none;
    box-shadow: 0 10px 24px -14px rgba(0, 0, 0, 0.9);
  }

  .tip__title {
    font-family: var(--font-print);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--chalk-100);
  }

  .tip__author {
    font-family: var(--font-print);
    font-size: 0.72rem;
    font-style: italic;
    color: var(--chalk-300);
  }

  .hint {
    position: absolute;
    left: 50%;
    bottom: var(--space-m);
    transform: translateX(-50%);
    margin: 0;
    font-family: var(--font-sign);
    font-size: var(--step--1);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--chalk-300);
    opacity: 0.55;
    pointer-events: none;
    white-space: nowrap;
  }

  /* --- The book panel -------------------------------------------------- */

  .panel {
    position: absolute;
    top: 50%;
    right: var(--space-l);
    width: min(22rem, calc(100vw - 2rem));
    transform: translate(1.5rem, -50%);
    opacity: 0;
    transition: transform 0.32s var(--ease-out), opacity 0.32s var(--ease-out);
    padding: var(--space-m);
    background: linear-gradient(180deg, rgba(28, 18, 12, 0.94), rgba(20, 13, 9, 0.96));
    border: 1px solid rgba(201, 162, 39, 0.22);
    border-radius: 3px;
    box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.9);
    backdrop-filter: blur(6px);
  }

  .panel.is-open {
    transform: translate(0, -50%);
    opacity: 1;
  }

  .panel__close {
    position: absolute;
    top: 0.6rem;
    right: 0.7rem;
    border: 0;
    background: transparent;
    color: var(--chalk-300);
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
  }

  .panel__cover {
    width: 7.5rem;
    aspect-ratio: 2 / 3;
    margin-bottom: var(--space-s);
    border-radius: 2px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.6rem;
    font-family: var(--font-print);
    font-size: 0.72rem;
    font-weight: 600;
    text-align: center;
    color: var(--brass-300);
    overflow: hidden;
    box-shadow: 0 10px 24px -16px rgba(0, 0, 0, 0.9);
  }

  .panel__cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .panel__state {
    margin: 0 0 0.2rem;
    font-family: var(--font-sign);
    font-size: var(--step--1);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--brass-400);
  }

  .panel__title {
    margin: 0 0 0.25rem;
    font-size: var(--step-1);
    line-height: 1.2;
    color: var(--chalk-100);
  }

  .panel__author {
    margin: 0 0 var(--space-2xs);
    font-style: italic;
    color: var(--chalk-300);
  }

  .panel__meta {
    margin: 0 0 var(--space-xs);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--chalk-300);
    opacity: 0.7;
  }

  .panel__notes {
    margin: 0 0 var(--space-s);
    font-size: var(--step--1);
    color: var(--chalk-200);
    opacity: 0.8;
  }

  .panel__link {
    font-family: var(--font-sign);
    font-size: var(--step--1);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--brass-300);
  }

  /* --- Loading --------------------------------------------------------- */

  .loading {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: #150d09;
    color: var(--chalk-300);
    font-family: var(--font-sign);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-size: var(--step--1);
    transition: opacity 1.2s var(--ease-out);
  }

  .loading.is-gone {
    opacity: 0;
    pointer-events: none;
  }
</style>
