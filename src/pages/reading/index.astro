---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";

const books = (await getCollection("books")).map((entry) => entry.data);

const byAuthor = (a: { author: string }, b: { author: string }) =>
  a.author.localeCompare(b.author);

const toRead = books.filter((b) => b.status === "to-read").sort(byAuthor);
const reading = books.filter((b) => b.status === "reading").sort(byAuthor);
const read = books.filter((b) => b.status === "read").sort(byAuthor);

const GENRES = [
  "self", "mind", "spirit", "business", "science",
  "history", "philosophy", "technology", "health", "memoir", "fiction", "misc",
] as const;

const GENRE_LABEL: Record<string, string> = {
  self: "Self & Practice",
  mind: "Mind",
  spirit: "Spirit",
  business: "Business",
  science: "Science",
  history: "History",
  philosophy: "Philosophy",
  technology: "Technology",
  health: "Health",
  memoir: "Memoir",
  fiction: "Fiction",
  misc: "Miscellany",
};

// Two hundred waiting books on the two cases, split down the alphabet.
const leftBooks = toRead.slice(0, 100);
const rightBooks = toRead.slice(100, 200);

const grouped = GENRES.map((genre) => ({
  id: genre,
  label: GENRE_LABEL[genre],
  books: books.filter((b) => (b.genre ?? "misc") === genre).sort(byAuthor),
})).filter((g) => g.books.length > 0);

const counts = {
  total: books.length,
  toRead: toRead.length,
  reading: reading.length,
  read: read.length,
};

function spineWidth(book: (typeof books)[number]) {
  const pages = book.pages ?? 200;
  return Math.max(7, Math.min(17, Math.round(7 + pages / 40)));
}
---

<Base
  title="The Attic Library — The Missing Semester"
  description="A reading room under the roof: books read, reading, and waiting."
  bodyClass="attic-page"
>
  <main class="attic">
    <header class="room-head">
      <p class="room__eyebrow">Subject 01 · The Library</p>
      <h1>The Attic Library</h1>
      <p class="room__intro">
        Under the roof, a window seat, a chair that knows my shape, and every
        book that made it this far.
      </p>
    </header>

    <section class="room" aria-label="The attic reading room">
      <!-- The room shell: plaster, timber, window, seat, floor, chair, table -->
