            <path d="M60 28 L92 60 L60 92 L28 60 Z" fill="#2f3f55" opacity="0.55" />
            <path d="M60 44 L76 60 L60 76 L44 60 Z" fill="#d9c39a" opacity="0.7" />
            <circle cx="60" cy="60" r="4" fill="#6f2d2a" />
            <path d="M0 0 L24 0 L0 24 Z M120 120 L96 120 L120 96 Z" fill="#2f3f55" opacity="0.35" />
