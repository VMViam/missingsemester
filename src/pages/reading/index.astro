        <!-- cushions -->
        <rect x="540" y="536" width="132" height="42" rx="18" fill="#efe9dc" opacity="0.95" />
        <rect x="676" y="532" width="120" height="46" rx="20" fill="#c9b79c" opacity="0.95" />
        <rect x="798" y="536" width="112" height="42" rx="18" fill="#f2ede3" opacity="0.95" />

