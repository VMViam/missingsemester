---
import Base from "../../layouts/Base.astro";
---

<Base
  title="The Attic Library — The Missing Semester"
  description="A reading room under the roof. Step in."
  bodyClass="attic-page"
>
  <main class="attic">
    <canvas
      id="attic-canvas"
      aria-label="A three-dimensional attic library with bookcases either side of an arched window."
    ></canvas>

    <header class="hud">
      <a class="hud__back" href="/">← The house</a>
      <div class="hud__title">
        <p class="hud__eyebrow">Subject 01 · The Library</p>
        <p class="hud__name">The Attic Library</p>
      </div>
      <a class="hud__catalogue" href="/reading/catalogue/">The catalogue</a>
    </header>

    <div class="tip" id="tip" hidden>
      <span class="tip__title" id="tip-title"></span>
      <span class="tip__author" id="tip-author"></span>
    </div>

    <div class="nav-pad" role="group" aria-label="Look around">
      <button type="button" id="pan-left" aria-label="Look left">←</button>
      <button type="button" id="pan-right" aria-label="Look right">→</button>
    </div>

    <div class="zoom" role="group" aria-label="Zoom">
      <button type="button" id="zoom-in" aria-label="Zoom in">＋</button>
      <button type="button" id="zoom-out" aria-label="Zoom out">−</button>
    </div>

    <p class="hint">Drag or ← → to look · scroll or ＋ / − to zoom · click a spine</p>

    <aside class="panel" id="panel" hidden aria-live="polite">
      <button class="panel__close" id="panel-close" type="button" aria-label="Close">×</button>
      <div class="panel__cover" id="panel-cover"></div>
      <p class="panel__state" id="panel-state"></p>
      <h2 class="panel__title" id="panel-title"></h2>
      <p class="panel__author" id="panel-author"></p>
      <p class="panel__meta" id="panel-meta"></p>
      <p class="panel__notes" id="panel-notes"></p>
      <a class="panel__link" id="panel-link" href="#">Open the book →</a>
    </aside>

    <div class="loading" id="loading"><span>Opening the attic…</span></div>
  </main>
</Base>

<script>
  import { createAttic } from "../../lib/attic/scene";
  import type { Book } from "../../lib/books";

  const canvas = document.getElementById("attic-canvas") as HTMLCanvasElement;
  const panel = document.getElementById("panel") as HTMLElement;
  const loading = document.getElementById("loading") as HTMLElement;
  const cover = document.getElementById("panel-cover") as HTMLElement;
  const title = document.getElementById("panel-title") as HTMLElement;
  const author = document.getElementById("panel-author") as HTMLElement;
  const meta = document.getElementById("panel-meta") as HTMLElement;
  const notes = document.getElementById("panel-notes") as HTMLElement;
  const state = document.getElementById("panel-state") as HTMLElement;
  const link = document.getElementById("panel-link") as HTMLAnchorElement;
  const tip = document.getElementById("tip") as HTMLElement;
  const tipTitle = document.getElementById("tip-title") as HTMLElement;
  const tipAuthor = document.getElementById("tip-author") as HTMLElement;

  const attic = createAttic(canvas, {
    onFocus(book: Book) {
      title.textContent = book.title;
      author.textContent = book.author;
      state.textContent =
        book.status === "reading" ? "on the seat" : book.status === "read" ? "finished" : "waiting";
      meta.textContent = [book.year, book.publisher, book.pages ? `${book.pages} pp` : null]
        .filter(Boolean)
        .join(" · ");
      notes.textContent = book.notes ?? "";
      notes.hidden = !book.notes;
      link.href = `/reading/${book.id}/`;

      cover.innerHTML = "";
      cover.style.background = book.spineColor ?? "#2f4858";
      if (book.coverUrl) {
        const img = document.createElement("img");
        img.src = book.coverUrl;
        img.alt = "";
        img.onerror = () => img.remove();
        cover.append(img);
      } else {
        cover.textContent = book.title;
      }
      panel.hidden = false;
      requestAnimationFrame(() => panel.classList.add("is-open"));
    },
    onClose() {
      panel.classList.remove("is-open");
      window.setTimeout(() => (panel.hidden = true), 260);
    },
    onHover(book: Book | null, x: number, y: number) {
      if (!book) {
        tip.hidden = true;
        return;
      }
      tipTitle.textContent = book.title;
      tipAuthor.textContent = book.author;
      tip.style.transform = `translate(${x + 14}px, ${y + 16}px)`;
      tip.hidden = false;
    },
  });

  document.getElementById("panel-close")?.addEventListener("click", () => {
    canvas.click();
  });

  const zoomIn = document.getElementById("zoom-in");
  const zoomOut = document.getElementById("zoom-out");
  zoomIn?.addEventListener("click", () => attic.zoom(0.22));
  zoomOut?.addEventListener("click", () => attic.zoom(-0.22));

  document.getElementById("pan-left")?.addEventListener("click", () => attic.pan(-0.3));
  document.getElementById("pan-right")?.addEventListener("click", () => attic.pan(0.3));

  window.addEventListener("keydown", (e) => {
    if (e.key === "+" || e.key === "=") attic.zoom(0.2);
    if (e.key === "-" || e.key === "_") attic.zoom(-0.2);
    if (e.key === "ArrowLeft") attic.pan(-0.25);
    if (e.key === "ArrowRight") attic.pan(0.25);
  });

  requestAnimationFrame(() => loading.classList.add("is-gone"));
  window.addEventListener("pagehide", () => attic.dispose());
</script>

<style is:global>
  body.attic-page {
    background: #1c120b;
    overflow: hidden;
  }

  body.attic-page .site-nav,
  body.attic-page .foot {
    display: none;
  }

  .attic {
    position: fixed;
    inset: 0;
    overflow: hidden;
    color: var(--chalk-100);
  }

  #attic-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .hud {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 5;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-m);
    padding: clamp(1rem, 2.2vw, 1.6rem);
    pointer-events: none;
    text-shadow: 0 1px 12px rgba(20, 12, 6, 0.6);
  }

  .hud a {
    pointer-events: auto;
    font-family: var(--font-sign);
    font-size: var(--step--1);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--chalk-200);
    text-decoration: none;
  }

  .hud a:hover {
    color: var(--chalk-100);
  }

  .hud__title {
    text-align: center;
  }

  .hud__eyebrow {
    margin: 0;
    font-family: var(--font-sign);
    font-size: 0.62rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--brass-300);
  }

  .hud__name {
    margin: 0.15rem 0 0;
    font-family: "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, serif;
    font-size: clamp(1.15rem, 2vw, 1.6rem);
    letter-spacing: -0.01em;
    color: #f7f0e2;
  }

  .tip[hidden] {
    display: none;
  }

  .tip {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 20;
    display: grid;
    gap: 1px;
    max-width: 19rem;
    padding: 0.4rem 0.55rem;
    background: rgba(24, 15, 9, 0.94);
    border: 1px solid rgba(201, 162, 39, 0.28);
    border-radius: 2px;
    pointer-events: none;
    box-shadow: 0 10px 24px -14px rgba(0, 0, 0, 0.9);
  }

  .tip__title {
    font-family: var(--font-print);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--chalk-100);
  }

  .tip__author {
    font-family: var(--font-print);
    font-size: 0.72rem;
    font-style: italic;
    color: var(--chalk-300);
  }

  .nav-pad {
    position: absolute;
    right: calc(clamp(1rem, 2.2vw, 1.8rem) + 2.7rem);
    bottom: clamp(1rem, 2.2vw, 1.8rem);
    z-index: 6;
    display: grid;
    grid-auto-flow: column;
    gap: 0.35rem;
  }

  .nav-pad button {
    width: 2.1rem;
    height: 2.1rem;
    display: grid;
    place-items: center;
    border: 1px solid rgba(247, 240, 226, 0.26);
    border-radius: 999px;
    background: rgba(30, 20, 12, 0.55);
    color: #f7f0e2;
    font-size: 0.95rem;
    line-height: 1;
    cursor: pointer;
    backdrop-filter: blur(3px);
    transition: background 160ms ease, border-color 160ms ease;
  }

  .nav-pad button:hover {
    background: rgba(201, 162, 39, 0.85);
    border-color: rgba(255, 232, 170, 0.9);
    color: #241a0e;
  }

  .zoom {
    position: absolute;
    right: clamp(1rem, 2.2vw, 1.8rem);
    bottom: clamp(1rem, 2.2vw, 1.8rem);
    z-index: 6;
    display: grid;
    gap: 0.35rem;
  }

  .zoom button {
    width: 2.1rem;
    height: 2.1rem;
    display: grid;
    place-items: center;
    border: 1px solid rgba(247, 240, 226, 0.26);
    border-radius: 999px;
    background: rgba(30, 20, 12, 0.55);
    color: #f7f0e2;
    font-size: 1rem;
    line-height: 1;
    cursor: pointer;
    backdrop-filter: blur(3px);
    transition: background 160ms ease, border-color 160ms ease;
  }

  .zoom button:hover {
    background: rgba(201, 162, 39, 0.85);
    border-color: rgba(255, 232, 170, 0.9);
    color: #241a0e;
  }

  .hint {
    position: absolute;
    left: 50%;
    bottom: 1.1rem;
    transform: translateX(-50%);
    z-index: 4;
    margin: 0;
    font-family: var(--font-sign);
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(247, 240, 226, 0.6);
    white-space: nowrap;
    pointer-events: none;
  }

  /* --- book panel ------------------------------------------------------- */

  .panel {
    position: absolute;
    top: 50%;
    right: clamp(1rem, 3vw, 2.4rem);
    z-index: 8;
    width: min(21rem, calc(100vw - 2rem));
    transform: translate(1.2rem, -50%);
    opacity: 0;
    transition: transform 0.32s var(--ease-out), opacity 0.32s var(--ease-out);
    padding: var(--space-m);
    background: linear-gradient(180deg, rgba(33, 22, 14, 0.95), rgba(24, 16, 10, 0.97));
    border: 1px solid rgba(201, 162, 39, 0.24);
    border-radius: 3px;
    box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.9);
    backdrop-filter: blur(6px);
  }

  .panel.is-open {
    transform: translate(0, -50%);
    opacity: 1;
  }

  .panel__close {
    position: absolute;
    top: 0.55rem;
    right: 0.7rem;
    border: 0;
    background: transparent;
    color: var(--chalk-300);
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
  }

  .panel__cover {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 7.2rem;
    aspect-ratio: 2 / 3;
    margin-bottom: var(--space-s);
    padding: 0.6rem;
    overflow: hidden;
    border-radius: 2px;
    font-family: var(--font-print);
    font-size: 0.7rem;
    font-weight: 600;
    line-height: 1.25;
    text-align: center;
    color: var(--brass-300);
    box-shadow: 0 12px 24px -16px rgba(0, 0, 0, 0.9);
  }

  .panel__cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .panel__state {
    margin: 0 0 0.2rem;
    font-family: var(--font-sign);
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--brass-400);
  }

  .panel__title {
    margin: 0 0 0.25rem;
    font-family: "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, serif;
    font-size: var(--step-2);
    font-weight: 400;
    line-height: 1.15;
    color: #f7f0e2;
  }

  .panel__author {
    margin: 0 0 var(--space-2xs);
    font-style: italic;
    color: var(--chalk-300);
  }

  .panel__meta {
    margin: 0 0 var(--space-xs);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--chalk-300);
    opacity: 0.7;
  }

  .panel__notes {
    margin: 0 0 var(--space-s);
    font-size: var(--step--1);
    color: var(--chalk-200);
    opacity: 0.85;
  }

  .panel__link {
    font-family: var(--font-sign);
    font-size: var(--step--1);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--brass-300);
  }

  /* --- loading ---------------------------------------------------------- */

  .loading {
    position: absolute;
    inset: 0;
    z-index: 10;
    display: grid;
    place-items: center;
    background: #1c120b;
    color: var(--chalk-300);
    font-family: var(--font-sign);
    font-size: var(--step--1);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    transition: opacity 1.1s var(--ease-out);
  }

  .loading.is-gone {
    opacity: 0;
    pointer-events: none;
  }
</style>
