---
import Base from "../../layouts/Base.astro";
import Shelf from "../../components/Shelf.astro";
import { getCollection } from "astro:content";

const books = (await getCollection("books")).map((entry) => entry.data);

const onLoan = books.filter((b) => b.status === "reading");
const onHold = books.filter((b) => b.status === "to-read");
const onShelf = books.filter((b) => b.status === "read");

const byAuthor = (a: Book, b: Book) => String(a.author).localeCompare(String(b.author));
onShelf.sort(byAuthor);
onHold.sort(byAuthor);
---

<Base
  title="The Library — The Missing Semester of Life's Education"
  description="Books read, being read, and waiting to be read."
>
  <main class="library">
    <header class="library__head">
      <p class="library__eyebrow">Subject 01</p>
      <h1>The Library</h1>
      <p class="library__lede">
        Every book I own, in the state I own it in: out with me, waiting on the
        holds drawer, or back on the shelf.
      </p>
      <dl class="counts">
        <div><dt>On the shelf</dt><dd>{onShelf.length}</dd></div>
        <div><dt>On loan</dt><dd>{onLoan.length}</dd></div>
        <div><dt>On hold</dt><dd>{onHold.length}</dd></div>
      </dl>
    </header>

    {
      onShelf.length > 0 && (
        <section class="group">
          <div class="group__head">
            <h2>On the shelf</h2>
            <p class="group__note">
              Finished, and kept. Reach for one and it comes off the shelf.
            </p>
          </div>
          <Shelf books={onShelf} label="Books on the shelf" />
        </section>
      )
    }

    {
      onLoan.length > 0 && (
        <section class="group">
          <div class="group__head">
            <h2>On loan</h2>
            <p class="group__note">
              Out with me now. A due-date slip, and a page left folded.
            </p>
          </div>
          <Shelf books={onLoan} pulledId={onLoan[0]?.id} label="Books currently out" />
        </section>
      )
    }

    {
      onHold.length > 0 && (
        <section class="group">
          <div class="group__head">
            <h2>On hold</h2>
            <p class="group__note">
              Requests in the drawer. The pile grows faster than it shrinks.
            </p>
          </div>
          <ul class="holds">
            {onHold.map((book) => (
              <li class="hold">
                <a href={`/reading/${book.id}/`}>
                  <span class="hold__title">{book.title}</span>
                  <span class="hold__author">{book.author}</span>
                  {book.year && <span class="hold__year">{book.year}</span>}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </main>
</Base>

<style>
  .library {
    max-width: 68rem;
    margin: 0 auto;
    padding: var(--space-xl) var(--space-m) var(--space-2xl);
  }

  .library__eyebrow {
    font-family: var(--font-sign);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: var(--step--1);
    color: var(--green-600);
    margin-bottom: var(--space-2xs);
  }

  h1 {
    font-size: var(--step-4);
    letter-spacing: -0.03em;
  }

  .library__lede {
    max-width: 44ch;
    color: var(--fg-muted);
    font-size: var(--step-1);
    line-height: 1.45;
  }

  .counts {
    display: flex;
    gap: var(--space-l);
    margin: var(--space-l) 0 0;
    padding: var(--space-s) 0;
    border-top: 1px solid var(--paper-400);
    border-bottom: 1px solid var(--paper-400);
  }

  .counts div {
    display: flex;
    flex-direction: column-reverse;
  }

  .counts dt {
    font-family: var(--font-sign);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: var(--step--1);
    color: var(--fg-muted);
  }

  .counts dd {
    margin: 0;
    font-size: var(--step-2);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .group {
    margin-top: var(--space-xl);
  }

  .group__head h2 {
    font-family: var(--font-sign);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: var(--step-1);
    margin-bottom: var(--space-3xs);
  }

  .group__note {
    color: var(--fg-muted);
    font-size: var(--step--1);
    margin-bottom: var(--space-s);
  }

  /* --- Holds drawer ----------------------------------------------------- */

  .holds {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: var(--space-2xs);
  }

  .hold {
    background: var(--bg-paper);
    border: 1px solid var(--paper-300);
    border-left: 3px solid var(--paper-400);
    border-radius: 2px;
  }

  .hold a {
    display: grid;
    gap: 2px;
    padding: var(--space-s);
    text-decoration: none;
  }

  .hold a:hover {
    background: var(--paper-100);
  }

  .hold__title {
    font-weight: 600;
    font-size: var(--step-0);
  }

  .hold__author {
    font-style: italic;
    color: var(--fg-muted);
    font-size: var(--step--1);
  }

  .hold__year {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink-300);
  }
</style>
