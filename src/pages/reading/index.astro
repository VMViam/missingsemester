          <rect x="1036" y="700" width="40" height="50" rx="8" fill="#4d2a16" />
          <rect x="1188" y="700" width="40" height="50" rx="8" fill="#4d2a16" />
          <rect x="1024" y="620" width="30" height="96" rx="12" fill="#5b351d" />
          <rect x="1210" y="620" width="30" height="96" rx="12" fill="#5b351d" />
        </g>

        <!-- round side table with books -->
        <g>
          <ellipse cx="1320" cy="760" rx="108" ry="18" fill="#3d2617" opacity="0.2" />
          <rect x="1312" y="660" width="16" height="100" fill="#4d2a16" />
          <ellipse cx="1320" cy="660" rx="104" ry="26" fill="#7a5233" />
          <ellipse cx="1320" cy="654" rx="104" ry="26" fill="#96683f" />
          <rect x="1268" y="628" width="66" height="12" rx="2" fill="#6f2d2a" />
          <rect x="1272" y="618" width="58" height="12" rx="2" fill="#2f3f55" />
          <rect x="1276" y="608" width="50" height="12" rx="2" fill="#6b472b" />
        </g>

        <!-- light through the window -->
        <polygon points="556,568 884,568 1120,900 260,900" fill="#fff3cf" opacity="0.16" />
        <polygon points="600,568 700,568 620,900 380,900" fill="#fff8e2" opacity="0.14" />
      </svg>

      <!-- The two built-in bookcases; the books are live HTML -->
      <div class="bay bay--left">
        <div class="bay__crown"></div>
        <span class="bay__plaque">To be read · A–M</span>
        {
          Array.from({ length: 5 }, (_, row) => (
            <div class="bay__shelf">
              {leftBooks.slice(row * 20, (row + 1) * 20).map((book) => (
                <a
                  class="spine"
                  href={`/reading/${book.id}/`}
                  style={`--c:${book.spineColor ?? "#4a4a52"};--f:${book.foilColor ?? "#d9bd72"};--bw:${spineWidth(book)}px;--bh:${70 + (spineWidth(book) % 7) * 4}%`}
                  title={`${book.title} — ${book.author}`}
                >
                  <span class="spine__tip">{book.title}</span>
                </a>
              ))}
            </div>
          ))
        }
        <div class="bay__base"></div>
      </div>

      <div class="bay bay--right">
        <div class="bay__crown"></div>
        <span class="bay__plaque">To be read · N–Z</span>
        {
          Array.from({ length: 5 }, (_, row) => (
            <div class="bay__shelf">
              {rightBooks.slice(row * 20, (row + 1) * 20).map((book) => (
                <a
                  class="spine"
                  href={`/reading/${book.id}/`}
                  style={`--c:${book.spineColor ?? "#4a4a52"};--f:${book.foilColor ?? "#d9bd72"};--bw:${spineWidth(book)}px;--bh:${72 + (spineWidth(book) % 6) * 4}%`}
                  title={`${book.title} — ${book.author}`}
                >
                  <span class="spine__tip">{book.title}</span>
                </a>
              ))}
            </div>
          ))
        }
        <div class="bay__base"></div>
      </div>

      <!-- Books on the window seat: the ones being read now -->
      <div class="seat-covers">
        {
          reading.slice(0, 3).map((book) => (
            <a class="seat-cover" href={`/reading/${book.id}/`} title={`${book.title} — ${book.author}`}>
              <span style={`--c:${book.spineColor ?? "#4a4a52"}`}>{book.title}</span>
              {book.coverUrl && (
                <img
                  src={book.coverUrl}
                  alt={`${book.title} by ${book.author}`}
                  loading="lazy"
                  onerror="this.remove()"
                />
              )}
            </a>
          ))
        }
        <p class="seat-note">reading now</p>
      </div>

      <!-- foreground furniture, in front of the shelves -->
      <svg class="room__foreground" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
        <g>
          <ellipse cx="962" cy="792" rx="100" ry="18" fill="#3d2617" opacity="0.2" />
          <rect x="884" y="600" width="168" height="150" rx="26" fill="url(#leather)" />
          <rect x="900" y="618" width="136" height="96" rx="20" fill="#8a5533" opacity="0.5" />
          <rect x="872" y="694" width="192" height="62" rx="22" fill="url(#leather)" />
          <rect x="884" y="744" width="36" height="46" rx="8" fill="#4d2a16" />
          <rect x="1020" y="744" width="36" height="46" rx="8" fill="#4d2a16" />
          <rect x="872" y="664" width="28" height="88" rx="11" fill="#5b351d" />
          <rect x="1036" y="664" width="28" height="88" rx="11" fill="#5b351d" />
        </g>
        <g>
          <ellipse cx="1150" cy="828" rx="100" ry="16" fill="#3d2617" opacity="0.22" />
          <rect x="1142" y="726" width="16" height="100" fill="#4d2a16" />
          <ellipse cx="1150" cy="726" rx="96" ry="24" fill="#7a5233" />
          <ellipse cx="1150" cy="720" rx="96" ry="24" fill="#96683f" />
          <rect x="1102" y="696" width="62" height="11" rx="2" fill="#6f2d2a" />
          <rect x="1106" y="687" width="54" height="11" rx="2" fill="#2f3f55" />
          <rect x="1110" y="678" width="46" height="11" rx="2" fill="#6b472b" />
        </g>
        <polygon points="556,568 884,568 1180,900 200,900" fill="#fff3cf" opacity="0.12" />
      </svg>

      <p class="room__hint">Hover a spine for its name · click to open it</p>
    </section>

    <section class="catalogue" aria-labelledby="catalogue-title">
      <header class="catalogue__head">
        <h2 id="catalogue-title">The catalogue</h2>
        <p class="catalogue__counts">
          {counts.total} books · {counts.toRead} to read · {counts.reading} reading · {counts.read} read
        </p>
      </header>

      <div class="catalogue__tools">
        <label class="search">
          <span>Search</span>
          <input type="search" id="search" placeholder="Title, author, subject…" autocomplete="off" />
        </label>
        <div class="filters" role="group" aria-label="Filter by status">
          <button type="button" data-filter="all" class="is-on">All</button>
          <button type="button" data-filter="to-read">To read</button>
          <button type="button" data-filter="reading">Reading</button>
          <button type="button" data-filter="read">Read</button>
        </div>
      </div>

      <div class="genres">
        {
          grouped.map((group) => (
            <details class="genre" open>
              <summary>
                <span class="genre__name">{group.label}</span>
                <span class="genre__count">{group.books.length}</span>
              </summary>
              <ul class="books">
                {group.books.map((book) => (
                  <li class="book" data-status={book.status}>
                    <a href={`/reading/${book.id}/`}>
                      <span class="book__title">{book.title}</span>
                      <span class="book__author">{book.author}</span>
                      <span class="book__mark" aria-label={book.status}>
                        {book.status === "reading" ? "◐" : book.status === "read" ? "●" : "○"}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          ))
        }
      </div>
      <p class="catalogue__empty" id="empty" hidden>No books match that search.</p>
    </section>
  </main>
</Base>

<script>
  const search = document.getElementById("search") as HTMLInputElement | null;
  const empty = document.getElementById("empty") as HTMLElement | null;
  const books = Array.from(document.querySelectorAll<HTMLElement>(".book"));
  const groups = Array.from(document.querySelectorAll<HTMLDetailsElement>(".genre"));
  const filters = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-filter]"));
  let status = "all";

  function apply() {
    const term = (search?.value ?? "").trim().toLowerCase();
    let visible = 0;

    for (const book of books) {
      const matchStatus = status === "all" || book.dataset.status === status;
      const matchText = !term || (book.textContent ?? "").toLowerCase().includes(term);
      const show = matchStatus && matchText;
      book.hidden = !show;
      if (show) visible++;
    }

    for (const group of groups) {
      const any = Array.from(group.querySelectorAll<HTMLElement>(".book")).some((b) => !b.hidden);
      group.hidden = !any;
      if (any && term) group.open = true;
    }

    if (empty) empty.hidden = visible > 0;
  }

  search?.addEventListener("input", apply);
  for (const button of filters) {
    button.addEventListener("click", () => {
      status = button.dataset.filter ?? "all";
      for (const other of filters) other.classList.toggle("is-on", other === button);
      apply();
    });
  }
</script>

<style>
  .attic-page {
    background: #e9dfcd;
  }

  .attic {
    max-width: 100%;
    overflow-x: hidden;
  }

  /* ------------------------------------------------------------------ room */

  .room {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    min-height: 34rem;
    overflow: hidden;
    background: #efe6d6;
  }

  .room__shell {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .room-head {
    max-width: 72rem;
    margin: 0 auto;
    padding: clamp(1.6rem, 4vw, 3rem) clamp(1.1rem, 4vw, 3rem) 1.2rem;
    background: var(--paper-200);
  }

  .room__eyebrow {
    margin: 0 0 0.35rem;
    font-family: var(--font-sign);
    font-size: var(--step--1);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #7a5233;
  }

  .room-head h1 {
    margin: 0 0 0.5rem;
    font-size: clamp(1.9rem, 3.6vw, 3.2rem);
    line-height: 1;
    letter-spacing: -0.03em;
    color: #3d2617;
  }

  .room__intro {
    margin: 0;
    max-width: 34ch;
    font-size: var(--step-0);
    line-height: 1.5;
    color: #5f4a35;
  }

  .room__hint {
    position: absolute;
    left: 50%;
    bottom: 1.1rem;
    transform: translateX(-50%);
    z-index: 4;
    margin: 0;
    font-family: var(--font-sign);
    font-size: var(--step--1);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #5f4a35;
    opacity: 0.65;
    white-space: nowrap;
  }

  /* ------------------------------------------------------------- bookcases */

  .bay {
    position: absolute;
    top: 13%;
    bottom: 16%;
    width: 21%;
    z-index: 3;
    display: flex;
    flex-direction: column;
    padding: 0.5% 0.55% 0.8%;
    background:
      linear-gradient(90deg, rgba(255, 255, 255, 0.06), transparent 18%, transparent 82%, rgba(0, 0, 0, 0.28)),
      linear-gradient(180deg, #5a3a22, #3d2617);
    border: 1px solid #2e1b0f;
    box-shadow:
      inset 0 0 0 6px #4a2f1b,
      inset 0 0 26px rgba(0, 0, 0, 0.6),
      0 18px 40px -24px rgba(40, 22, 8, 0.8);
  }

  .bay--left {
    left: 1.2%;
  }

  .bay--right {
    right: 1.2%;
  }

  .bay__crown,
  .bay__base {
    height: 3.2%;
    background: linear-gradient(180deg, #7a5233, #4a2f1b);
    border-radius: 2px;
  }

  .bay__shelf {
    position: relative;
    flex: 1;
    display: flex;
    align-items: flex-end;
    gap: 2px;
    padding: 0 3px 0 4px;
    border-bottom: 3px solid #2e1b0f;
    box-shadow: inset 0 -6px 8px -6px rgba(0, 0, 0, 0.8);
    overflow: visible;
  }

  .bay__plaque {
    position: absolute;
    left: 50%;
    top: -1.15rem;
    transform: translateX(-50%);
    padding: 0.12rem 0.5rem;
    background: #2a1d0e;
    border: 1px solid #a9842a;
    border-radius: 1px;
    font-family: var(--font-sign);
    font-size: 0.55rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #e8dcc0;
    white-space: nowrap;
    pointer-events: none;
  }

  .spine {
    position: relative;
    flex: 0 0 auto;
    display: block;
    width: var(--bw);
    height: var(--bh);
    background-color: var(--c);
    background-image:
      linear-gradient(90deg, rgba(255, 255, 255, 0.18), transparent 30%, rgba(0, 0, 0, 0.25)),
      linear-gradient(180deg, transparent 12%, rgba(0, 0, 0, 0.2) 12% 14%, transparent 14% 82%, rgba(0, 0, 0, 0.2) 82% 84%, transparent 84%);
    border-radius: 1px;
    box-shadow:
      inset 1px 0 0 rgba(255, 255, 255, 0.14),
      inset -1px 0 0 rgba(0, 0, 0, 0.35),
      0 1px 2px rgba(0, 0, 0, 0.4);
    transform-origin: bottom center;
    transition: transform 180ms ease, filter 180ms ease;
    text-decoration: none;
    z-index: 1;
  }

  .spine::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 18%;
    bottom: 49%;
    width: 1px;
    background: var(--f);
    opacity: 0.65;
  }

  .spine:hover,
  .spine:focus-visible {
    transform: translateY(-7px) rotate(-1.5deg);
    filter: brightness(1.25);
