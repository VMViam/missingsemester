        <path d="M556 566 L556 300 A164 164 0 0 1 884 300 L884 566 Z" fill="none" stroke="#e9e2d4" stroke-width="16" />
        <path d="M548 566 L892 566" stroke="#d8cdb9" stroke-width="8" />

        <!-- window seat -->
        <rect x="512" y="566" width="416" height="26" rx="4" fill="#efe7d8" />
