---
import type { Book } from "../lib/books";
import { geometryFor, spineColorFor, foilColorFor } from "../lib/books";

/**
 * One book, standing on a shelf.
 *
 * A real box in CSS 3D: the spine faces you, the top edge shows the page
 * block, and the front cover is on the right-hand face — visible only when
 * you pull the book out.
 *
 * IMPORTANT — keep the DOM shallow. Chromium's accessibility tree ignores
 * text nested more than ~5 levels inside unnamed containers, so a title
 * buried under wrappers is invisible to screen readers and find-in-page.
 * The link is the book: the spine is its background, the other two faces are
 * its pseudo-elements, and the title is a direct child.
 */
interface Props {
  book: Book;
  /** Books currently on loan sit pulled out of the shelf. */
  pulled?: boolean;
  /** Render as a link to the book's page. */
  href?: string;
}

const { book, pulled = false, href } = Astro.props;

const g = geometryFor(book);
const spine = spineColorFor(book);
const foil = foilColorFor(book);

const style = [
  `--w:${g.w}px`,
  `--h:${g.h}px`,
  `--d:${g.d}px`,
  `--spine:${spine}`,
  `--foil:${foil}`,
  `--lean:${g.lean}deg`,
  `--cover-title:"${book.title.replace(/"/g, "'")}"`,
  book.coverUrl ? `--cover-img:url("${book.coverUrl}")` : `--cover-img:none`,
].join(";");

const Tag = href ? "a" : "div";
---

<Tag
  class:list={["book", { "book--lean": g.leans, "book--pulled": pulled }]}
  style={style}
  href={href}
  aria-label={href ? `${book.title} — ${book.author}` : undefined}
>
  <span class="book__title">{book.title}</span>
  <span class="book__author">{book.author}</span>
  {
    pulled && (
      <span class="book__slip" aria-hidden="true">
        <span class="book__slip-label">Due</span>
        <span class="book__slip-value">{book.progress ? `${book.progress}%` : "Out"}</span>
      </span>
    )
  }
</Tag>

<style>
  .book {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    width: var(--w);
    height: var(--h);
    padding: 10px 3px 8px;
    text-decoration: none;
    color: inherit;
    transform-style: preserve-3d;
    transform: translateZ(0) rotateZ(var(--lean));
    transition: transform 620ms var(--ease-out);
    cursor: pointer;

    /* The spine: cloth weave, raised bands, light from the upper left. */
    background-color: var(--spine);
    background-image:
      repeating-linear-gradient(
        90deg,
        rgba(255, 255, 255, 0.05) 0 1px,
        rgba(0, 0, 0, 0.05) 1px 2px
      ),
      linear-gradient(
        180deg,
        transparent 0 14%,
        rgba(0, 0, 0, 0.22) 14% 15.4%,
        transparent 15.4% 78%,
        rgba(0, 0, 0, 0.22) 78% 79.4%,
        transparent 79.4%
      ),
      linear-gradient(
        100deg,
        rgba(255, 255, 255, 0.2) 0%,
        rgba(255, 255, 255, 0.02) 28%,
        rgba(0, 0, 0, 0.16) 78%,
        rgba(0, 0, 0, 0.34) 100%
      );
    box-shadow:
      inset 1px 0 0 rgba(255, 255, 255, 0.14),
      inset -1px 0 0 rgba(0, 0, 0, 0.3);
  }

  /* --- The front cover: the right-hand face ---------------------------- */

  .book::before {
    content: var(--cover-title);
    position: absolute;
    left: 50%;
    top: 0;
    width: var(--d);
    height: 100%;
    margin-left: calc(var(--d) / -2);
    transform: rotateY(90deg) translateZ(calc(var(--w) / 2));
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 10px 5px;
    text-align: center;
    overflow: hidden;
    word-break: break-word;
    hyphens: auto;
    font-family: var(--font-print);
    font-size: 8px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--foil);
    background-color: color-mix(in srgb, var(--spine) 70%, #000);
    background-image:
      var(--cover-img),
      linear-gradient(160deg, rgba(255, 255, 255, 0.1) 0%, rgba(0, 0, 0, 0.25) 75%);
    background-size: cover;
    background-position: center;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.25);
  }

  /* --- The top edge: the page block ------------------------------------ */

  .book::after {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    width: 100%;
    height: var(--d);
    margin-top: calc(var(--d) / -2);
    transform: rotateX(90deg) translateZ(calc(var(--h) / -2));
    background:
      repeating-linear-gradient(90deg, rgba(0, 0, 0, 0.16) 0 1px, transparent 1px 3px),
      linear-gradient(180deg, #efe9dd 0%, #cfc4ac 100%);
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.2);
  }

  /* --- The lettering ---------------------------------------------------- */

  .book__title {
    writing-mode: vertical-rl;
    text-orientation: mixed;
    font-family: var(--font-print);
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--foil);
    text-shadow: 0 1px 0 rgba(0, 0, 0, 0.45);
    max-height: 74%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .book__author {
    writing-mode: vertical-rl;
    text-orientation: mixed;
    font-family: var(--font-sign);
    font-size: 8px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--foil) 78%, transparent);
    max-height: 22%;
    overflow: hidden;
    white-space: nowrap;
  }

  /* --- The due-date slip, tucked into a book that's out ------------------ */

  .book__slip {
    position: absolute;
    bottom: 26px;
    left: 50%;
    transform: translateX(-50%) rotate(-3deg);
    display: grid;
    justify-items: center;
    gap: 1px;
    padding: 4px 5px;
    background: var(--paper-100);
    border: 1px solid var(--paper-400);
    border-radius: 1px;
    box-shadow: 0 2px 4px -2px rgba(0, 0, 0, 0.6);
    z-index: 2;
  }

  .book__slip-label {
    font-family: var(--font-sign);
    font-size: 6.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gym-red-500);
  }

  .book__slip-value {
    font-family: var(--font-mono);
    font-size: 7.5px;
    color: var(--ink-700);
    white-space: nowrap;
  }

  /* --- Pull it out ------------------------------------------------------ */

  .book:hover,
  .book:focus-visible {
    transform: translateZ(70px) rotateY(-24deg) rotateX(3deg) translateY(-12px)
      rotateZ(0deg);
  }

  .book--pulled {
    transform: translateZ(70px) rotateY(-20deg) translateY(-14px);
  }

  @media (prefers-reduced-motion: reduce) {
    .book,
    .book:hover,
    .book--pulled {
      transition: none;
    }
  }
</style>
